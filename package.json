{
	"name": "wisteria",
	"version": "2024.2.0-wisteria-1.4.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/okayurisotto/wisteria.git"
	},
	"packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065",
	"private": true,
	"scripts": {
		"build": "turbo build && node ./scripts/build-assets.mjs",
		"build-misskey-js-with-types": "turbo build && pnpm --filter backend generate-api-json && pnpm --filter misskey-js generate && turbo build",
		"start": "node ./packages/backend/built/boot/entry.js",
		"migrate": "pnpm --filter backend migrate",
		"revert": "pnpm --filter backend revert",
		"migrateandstart": "pnpm migrate && pnpm start",
		"clean": "node ./scripts/clean.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.9",
		"@tsconfig/node-lts": "24.0.0",
		"@tsconfig/strictest": "2.0.8",
		"@types/ignore-walk": "4.0.3",
		"cssnano": "7.1.2",
		"fast-glob": "3.3.3",
		"ignore-walk": "8.0.0",
		"postcss": "8.5.6",
		"tar": "7.5.20",
		"turbo": "2.10.4",
		"typescript": "6.0.3"
	}
}
