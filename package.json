{
	"name": "wisteria",
	"version": "2024.2.0-wisteria-1.3.1",
	"repository": {
		"type": "git",
		"url": "https://github.com/okayurisotto/wisteria.git"
	},
	"packageManager": "pnpm@10.33.1+sha512.05ba3c1d5d1c18f68df06470d74055e62d41fc110a0c660db1b2dfb2785327f04cf0f68345d4609bc52089e7fa0343c31593b2f9594e2c5d5da426230acc9820",
	"private": true,
	"scripts": {
		"build": "turbo build && node ./scripts/build-assets.mjs",
		"build-misskey-js-with-types": "turbo build && pnpm --filter backend generate-api-json && pnpm --filter misskey-js generate && turbo build",
		"start": "node ./packages/backend/built/boot/entry.js",
		"migrate": "pnpm --filter backend migrate",
		"revert": "pnpm --filter backend revert",
		"migrateandstart": "pnpm migrate && pnpm start",
		"clean": "node ./scripts/clean.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.9",
		"@tsconfig/node-lts": "24.0.0",
		"@tsconfig/strictest": "2.0.8",
		"@types/ignore-walk": "4.0.3",
		"cssnano": "7.1.2",
		"fast-glob": "3.3.3",
		"ignore-walk": "8.0.0",
		"postcss": "8.5.6",
		"tar": "7.5.11",
		"turbo": "2.9.6",
		"typescript": "6.0.3"
	}
}
