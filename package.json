{
	"name": "wisteria",
	"version": "2024.2.0-wisteria-1.7.1",
	"repository": {
		"type": "git",
		"url": "https://github.com/okayurisotto/wisteria.git"
	},
	"packageManager": "pnpm@12.21.0",
	"private": true,
	"scripts": {
		"build": "node ./scripts/build.mjs",
		"build-misskey-js-with-types": "turbo build && pnpm --filter backend generate-api-json && pnpm --filter misskey-js generate && turbo build",
		"test-vite-manifest-with-actual-manifest": "turbo build && mv packages/frontend/built/manifest.json packages/vite-manifest/test/manifest.json && pnpm --filter vite-manifest test",
		"start": "node ./scripts/start.mjs",
		"migrate": "pnpm --filter backend migrate",
		"revert": "pnpm --filter backend revert",
		"migrateandstart": "node ./scripts/start.mjs --migration",
		"clean": "node ./scripts/clean.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.9",
		"@tsconfig/node-lts": "24.0.1",
		"@tsconfig/strictest": "2.0.8",
		"cssnano": "7.1.2",
		"oxlint": "1.88.0",
		"postcss": "8.5.6",
		"tar": "7.5.20",
		"tinyglobby": "0.2.17",
		"turbo": "2.11.8",
		"typescript": "6.0.3"
	}
}
