{
	"name": "wisteria",
	"version": "2024.2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/okayurisotto/wisteria.git"
	},
	"packageManager": "pnpm@9.13.2+sha512.88c9c3864450350e65a33587ab801acf946d7c814ed1134da4a924f6df5a2120fd36b46aab68f7cd1d413149112d53c7db3a4136624cfd00ff1846a0c6cef48a",
	"private": true,
	"scripts": {
		"build-pre": "node ./scripts/build-pre.mjs",
		"build-assets": "node ./scripts/build-assets.mjs",
		"build": "pnpm build-pre && turbo build && pnpm build-assets",
		"build-misskey-js-with-types": "pnpm build-pre && pnpm --filter backend... --filter=!misskey-js build && pnpm --filter backend generate-api-json && pnpm --filter misskey-js generate && pnpm --filter misskey-js build",
		"start": "node ./packages/backend/built/boot/entry.js",
		"init": "pnpm migrate",
		"migrate": "cd packages/backend && pnpm migrate",
		"revert": "cd packages/backend && pnpm revert",
		"migrateandstart": "pnpm migrate && pnpm start",
		"clean": "node ./scripts/clean.mjs"
	},
	"resolutions": {
		"chokidar": "3.5.3",
		"lodash": "4.17.21"
	},
	"devDependencies": {
		"@eslint/js": "^9.15.0",
		"@stylistic/eslint-plugin": "^2.10.1",
		"@tsconfig/node-lts": "^22.0.0",
		"@tsconfig/strictest": "^2.0.5",
		"@types/eslint__js": "^8.42.3",
		"@types/ignore-walk": "4.0.3",
		"@types/js-yaml": "4.0.9",
		"@types/tar": "6.1.13",
		"cssnano": "6.0.3",
		"eslint": "^9.15.0",
		"eslint-plugin-vue": "^9.31.0",
		"fast-glob": "3.3.2",
		"ignore-walk": "6.0.4",
		"js-yaml": "4.1.0",
		"ncp": "2.0.0",
		"postcss": "8.4.33",
		"start-server-and-test": "2.0.3",
		"tar": "6.2.0",
		"terser": "5.27.0",
		"turbo": "^2.2.3",
		"typescript": "5.5.4",
		"typescript-eslint": "^8.14.0"
	}
}
