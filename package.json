{
	"name": "wisteria",
	"version": "2024.2.0-wisteria-1.2.3",
	"repository": {
		"type": "git",
		"url": "https://github.com/okayurisotto/wisteria.git"
	},
	"packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
	"private": true,
	"scripts": {
		"build": "turbo build && node ./scripts/build-assets.mjs",
		"build-misskey-js-with-types": "turbo build && pnpm --filter backend generate-api-json && pnpm --filter misskey-js generate && turbo build",
		"start": "node ./packages/backend/built/boot/entry.js",
		"migrate": "pnpm --filter backend migrate",
		"revert": "pnpm --filter backend revert",
		"migrateandstart": "pnpm migrate && pnpm start",
		"clean": "node ./scripts/clean.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.7",
		"@tsconfig/node-lts": "24.0.0",
		"@tsconfig/strictest": "2.0.8",
		"@types/ignore-walk": "4.0.3",
		"cssnano": "7.1.2",
		"fast-glob": "3.3.3",
		"ignore-walk": "8.0.0",
		"postcss": "8.5.6",
		"tar": "7.5.11",
		"turbo": "2.8.17",
		"typescript": "5.9.3"
	}
}
