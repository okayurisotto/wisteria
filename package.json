{
	"name": "wisteria",
	"version": "2024.2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/okayurisotto/wisteria.git"
	},
	"packageManager": "pnpm@9.7.0+sha512.dc09430156b427f5ecfc79888899e1c39d2d690f004be70e05230b72cb173d96839587545d09429b55ac3c429c801b4dc3c0e002f653830a420fa2dd4e3cf9cf",
	"private": true,
	"scripts": {
		"build-pre": "node ./scripts/build-pre.mjs",
		"build-assets": "node ./scripts/build-assets.mjs",
		"build": "pnpm build-pre && turbo build && pnpm build-assets",
		"build-storybook": "pnpm --filter frontend build-storybook",
		"build-misskey-js-with-types": "pnpm build-pre && pnpm --filter backend... --filter=!misskey-js build && pnpm --filter backend generate-api-json && ncp packages/backend/built/api.json packages/misskey-js/generator/api.json && pnpm --filter misskey-js update-autogen-code && pnpm --filter misskey-js build && pnpm --filter misskey-js api",
		"start": "node ./packages/backend/built/boot/entry.js",
		"start:test": "NODE_ENV=test node ./packages/backend/built/boot/entry.js",
		"init": "pnpm migrate",
		"migrate": "cd packages/backend && pnpm migrate",
		"revert": "cd packages/backend && pnpm revert",
		"migrateandstart": "pnpm migrate && pnpm start",
		"lint": "pnpm -r lint",
		"cy:open": "pnpm cypress open --browser --e2e --config-file=cypress.config.ts",
		"cy:run": "pnpm cypress run",
		"e2e": "pnpm start-server-and-test start:test http://localhost:61812 cy:run",
		"test": "pnpm -r test",
		"test-and-coverage": "pnpm -r test-and-coverage",
		"clean": "node ./scripts/clean.mjs"
	},
	"resolutions": {
		"chokidar": "3.5.3",
		"lodash": "4.17.21"
	},
	"devDependencies": {
		"@eslint/js": "^9.9.0",
		"@stylistic/eslint-plugin": "^2.6.2",
		"@tsconfig/node-lts": "^20.1.3",
		"@tsconfig/strictest": "^2.0.5",
		"@types/eslint__js": "^8.42.3",
		"@types/ignore-walk": "4.0.3",
		"@types/js-yaml": "4.0.9",
		"@types/tar": "6.1.13",
		"cssnano": "6.0.3",
		"cypress": "13.6.3",
		"eslint": "^9.9.0",
		"eslint-plugin-vue": "^9.27.0",
		"execa": "8.0.1",
		"fast-glob": "3.3.2",
		"ignore-walk": "6.0.4",
		"js-yaml": "4.1.0",
		"ncp": "2.0.0",
		"postcss": "8.4.33",
		"start-server-and-test": "2.0.3",
		"tar": "6.2.0",
		"terser": "5.27.0",
		"turbo": "^2.0.12",
		"typescript": "5.5.4",
		"typescript-eslint": "^7.18.0"
	}
}
