{
	"name": "wisteria",
	"version": "2024.2.0-wisteria-1.0.1",
	"repository": {
		"type": "git",
		"url": "https://github.com/okayurisotto/wisteria.git"
	},
	"packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a",
	"private": true,
	"scripts": {
		"build": "turbo build && node ./scripts/build-assets.mjs",
		"build-misskey-js-with-types": "turbo build && pnpm --filter backend generate-api-json && pnpm --filter misskey-js generate && turbo build",
		"start": "node ./packages/backend/built/boot/entry.js",
		"migrate": "pnpm --filter backend migrate",
		"revert": "pnpm --filter backend revert",
		"migrateandstart": "pnpm migrate && pnpm start",
		"clean": "node ./scripts/clean.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"@tsconfig/node-lts": "22.0.2",
		"@tsconfig/strictest": "2.0.8",
		"@types/ignore-walk": "4.0.3",
		"@types/js-yaml": "4.0.9",
		"@types/tar": "6.1.13",
		"cssnano": "7.1.1",
		"fast-glob": "3.3.3",
		"ignore-walk": "8.0.0",
		"js-yaml": "4.1.0",
		"postcss": "8.5.6",
		"tar": "7.4.3",
		"turbo": "2.6.3",
		"typescript": "5.9.3"
	}
}
