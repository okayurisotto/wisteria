{
	"name": "wisteria",
	"version": "2024.2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/okayurisotto/wisteria.git"
	},
	"packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0",
	"private": true,
	"scripts": {
		"build-assets": "node ./scripts/build-assets.mjs",
		"build": "turbo build && pnpm build-assets",
		"build-misskey-js-with-types": "pnpm --filter backend... --filter=!misskey-js build && pnpm --filter backend generate-api-json && pnpm --filter misskey-js generate && pnpm --filter misskey-js build",
		"start": "node ./packages/backend/built/boot/entry.js",
		"init": "pnpm migrate",
		"migrate": "cd packages/backend && pnpm migrate",
		"revert": "cd packages/backend && pnpm revert",
		"migrateandstart": "pnpm migrate && pnpm start",
		"clean": "node ./scripts/clean.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^9.18.0",
		"@stylistic/eslint-plugin": "^2.13.0",
		"@tsconfig/node-lts": "^22.0.1",
		"@tsconfig/strictest": "^2.0.5",
		"@types/eslint__js": "^8.42.3",
		"@types/ignore-walk": "4.0.3",
		"@types/js-yaml": "4.0.9",
		"@types/tar": "6.1.13",
		"cssnano": "6.0.3",
		"eslint": "^9.18.0",
		"eslint-plugin-vue": "^9.32.0",
		"fast-glob": "3.3.2",
		"ignore-walk": "6.0.4",
		"js-yaml": "4.1.0",
		"ncp": "2.0.0",
		"postcss": "8.4.33",
		"start-server-and-test": "2.0.3",
		"tar": "^6.2.1",
		"terser": "5.27.0",
		"turbo": "^2.3.3",
		"typescript": "5.7.3",
		"typescript-eslint": "^8.20.0"
	}
}
