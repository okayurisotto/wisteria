{
	"name": "wisteria",
	"version": "2024.2.0-wisteria-1.2.2",
	"repository": {
		"type": "git",
		"url": "https://github.com/okayurisotto/wisteria.git"
	},
	"packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
	"private": true,
	"scripts": {
		"build": "turbo build && node ./scripts/build-assets.mjs",
		"build-misskey-js-with-types": "turbo build && pnpm --filter backend generate-api-json && pnpm --filter misskey-js generate && turbo build",
		"start": "node ./packages/backend/built/boot/entry.js",
		"migrate": "pnpm --filter backend migrate",
		"revert": "pnpm --filter backend revert",
		"migrateandstart": "pnpm migrate && pnpm start",
		"clean": "node ./scripts/clean.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.4",
		"@tsconfig/node-lts": "24.0.0",
		"@tsconfig/strictest": "2.0.8",
		"@types/ignore-walk": "4.0.3",
		"@types/tar": "6.1.13",
		"cssnano": "7.1.2",
		"fast-glob": "3.3.3",
		"ignore-walk": "8.0.0",
		"postcss": "8.5.6",
		"tar": "7.5.10",
		"turbo": "2.8.13",
		"typescript": "5.9.3"
	}
}
