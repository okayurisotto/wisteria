{
	"name": "misskey-js",
	"description": "Misskey SDK for JavaScript",
	"type": "module",
	"exports": {
		"import": "./built/index.js",
		"types": "./built/index.d.ts"
	},
	"scripts": {
		"build": "tsup",
		"watch": "tsup --watch",
		"generate": "openapi-typescript ../backend/built/api.json -o ./src/autogen.ts"
	},
	"devDependencies": {
		"@types/node": "^20.14.14",
		"openapi-typescript": "^6",
		"tsup": "^8.2.4",
		"typescript": "5.5.4"
	},
	"files": [
		"built"
	],
	"dependencies": {
		"eventemitter3": "5.0.1",
		"reconnecting-websocket": "4.4.0"
	}
}
