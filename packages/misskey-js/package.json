{
	"name": "misskey-js",
	"description": "Misskey SDK for JavaScript",
	"type": "module",
	"exports": {
		"types": "./built/index.d.ts",
		"import": "./built/index.js"
	},
	"scripts": {
		"build": "tsdown",
		"generate": "openapi-typescript ../backend/built/api.json -o ./src/autogen.ts",
		"typecheck:app": "tsc --project tsconfig.app.json",
		"typecheck:dev": "tsc --project tsconfig.dev.json",
		"watch": "tsdown --watch"
	},
	"devDependencies": {
		"@types/node": "24.10.13",
		"openapi-typescript": "6.7.6",
		"tsdown": "0.22.7",
		"typescript": "6.0.3"
	},
	"files": [
		"built"
	],
	"dependencies": {
		"eventemitter3": "5.0.4",
		"reconnecting-websocket": "4.4.0"
	}
}
