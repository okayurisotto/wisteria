{
	"compilerOptions": {
		"composite": true,
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"paths": {
			"@/*": ["./src/*"]
		},
		"target": "ES2022",
		"typeRoots": [
			"./@types",
			"./node_modules/@types",
			"./node_modules/@vue-macros",
			"./node_modules"
		],
		"types": ["vite/client", "vitest/importMeta"],
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
	},
	"extends": "../../tsconfig.base.json",
	"include": ["src"]
}
