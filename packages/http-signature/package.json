		"watch": "tsdown --watch"
	},
	"dependencies": {
		"parcom": "workspace:*",
		"sshpk": "1.18.0"
	},
	"devDependencies": {
		"@types/node": "24.10.13",
		"@types/sshpk": "1.17.4",
		"tsdown": "0.22.7",
		"vitest": "4.1.9"
	}
}
