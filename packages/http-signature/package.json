		"typecheck:dev": "tsc --project tsconfig.dev.json",
		"watch": "tsup --watch"
	},
	"dependencies": {
		"parcom": "workspace:*",
		"sshpk": "1.18.0"
	},
	"devDependencies": {
		"@types/node": "24.10.13",
		"@types/sshpk": "1.17.4",
		"tsup": "8.5.1",
		"vitest": "4.1.5"
	}
}
