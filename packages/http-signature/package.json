{
	"name": "http-signature",
	"license": "MIT",
	"type": "module",
	"exports": {
		"./node": {
			"types": "./built/node.d.ts",
			"import": "./built/node.js"
		},
		"./web": {
			"types": "./built/web.d.ts",
			"import": "./built/web.js"
		}
	},
	"scripts": {
