{
	"name": "http-signature",
	"license": "MIT",
	"type": "module",
	"exports": {
		"./node": {
			"import": "./built/node.js",
			"types": "./src/node.ts"
		},
		"./web": {
			"import": "./built/web.js",
			"types": "./src/web.ts"
		}
	},
	"scripts": {
		"build": "tsup",
		"test": "vitest run",
